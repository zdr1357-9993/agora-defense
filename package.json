{
  "name": "agora-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/xlsx-to-json.mjs",
    "dev": "npm run data && vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:stage": "tsc --noEmit && vite build --outDir dist-stage",
    "preview": "vite preview",
    "preview:stage": "vite preview --host 127.0.0.1 --port 4173 --strictPort --outDir dist-stage"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "galmuri": "2.39.2"
  }
}
